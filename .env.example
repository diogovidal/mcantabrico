# URL pública del sitio (usada en metadata y schemas SEO)
NEXT_PUBLIC_SITE_URL=https://emcantabrico.es

# Google Places API (New) — rating, reviews y fotos reales del negocio.
# Sin estas dos variables, las secciones de reviews/fotos muestran un
# fallback elegante en lugar de fallar.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
